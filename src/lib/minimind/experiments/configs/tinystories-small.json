{
  "version": 1,
  "name": "tinystories-small",
  "description": "Small TinyStories training — validates convergence with a slightly larger model",
  "seed": 42,
  "dataset": {
    "type": "tinystories",
    "split": "train",
    "maxDocuments": 2000,
    "blockSize": 256,
    "batchSize": 16
  },
  "model": {
    "preset": "custom",
    "vocabSize": 32000,
    "dModel": 512,
    "numHeads": 8,
    "dFF": 2048,
    "numLayers": 8,
    "maxSeqLen": 256
  },
  "tokenizer": {
    "type": "bpe",
    "vocabSize": 32000
  },
  "optimizer": {
    "type": "adamw",
    "lr": 0.0001,
    "weightDecay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  },
  "scheduler": {
    "type": "cosine",
    "warmupSteps": 1000,
    "minLR": 1e-6
  },
  "training": {
    "epochs": 20,
    "gradientAccumulationSteps": 8,
    "gradientClipNorm": 1.0,
    "logInterval": 10,
    "evalEvery": 100
  },
  "output": {
    "dir": ".cache/minimind/experiments"
  }
}
