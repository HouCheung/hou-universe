{
  "version": 1,
  "name": "tinystories-tiny",
  "description": "Minimal TinyStories training — validates the full pipeline with a tiny model",
  "seed": 42,
  "dataset": {
    "type": "tinystories",
    "split": "train",
    "maxDocuments": 500,
    "blockSize": 128,
    "batchSize": 8
  },
  "model": {
    "preset": "tiny",
    "vocabSize": 32000,
    "dModel": 256,
    "numHeads": 8,
    "dFF": 1024,
    "numLayers": 6,
    "maxSeqLen": 128
  },
  "tokenizer": {
    "type": "bpe",
    "vocabSize": 32000
  },
  "optimizer": {
    "type": "adamw",
    "lr": 0.0003,
    "weightDecay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  },
  "scheduler": {
    "type": "cosine",
    "warmupSteps": 500,
    "minLR": 1e-6
  },
  "training": {
    "epochs": 10,
    "gradientAccumulationSteps": 4,
    "gradientClipNorm": 1.0,
    "logInterval": 10,
    "evalEvery": 50
  },
  "output": {
    "dir": ".cache/minimind/experiments"
  }
}
