{
  "version": 1,
  "name": "tinystories-production",
  "description": "Phase 55 production training campaign — real GPT pretraining on TinyStories. Uses the 'small' model architecture (dModel=256, 6 layers, 8 heads, ~12M params) trained for 20 epochs with AdamW + cosine scheduler + 500 warmup steps. Designed for research reproducibility.",
  "seed": 42,
  "dataset": {
    "type": "tinystories",
    "split": "train",
    "maxDocuments": 5000,
    "blockSize": 128,
    "batchSize": 16
  },
  "model": {
    "preset": "custom",
    "vocabSize": 32000,
    "dModel": 256,
    "numHeads": 8,
    "dFF": 1024,
    "numLayers": 6,
    "maxSeqLen": 128
  },
  "tokenizer": {
    "type": "bpe",
    "vocabSize": 32000
  },
  "optimizer": {
    "type": "adamw",
    "lr": 0.0003,
    "weightDecay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  },
  "scheduler": {
    "type": "cosine",
    "warmupSteps": 500,
    "minLR": 3e-6
  },
  "training": {
    "epochs": 20,
    "gradientAccumulationSteps": 4,
    "gradientClipNorm": 1.0,
    "logInterval": 10,
    "evalEvery": 0
  },
  "output": {
    "dir": ".cache/minimind/campaigns"
  }
}
